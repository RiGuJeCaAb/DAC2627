"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scrL3Detalhe.conEcraL3b.conConteudoL3b.conL3bCartao.conL3PubsUtil.lblL3TituloPubs.Text"}},"logicalLocations":[{"fullyQualifiedName":"scrL3Detalhe.conEcraL3b.conConteudoL3b.conL3bCartao.conL3PubsUtil.lblL3TituloPubs.Text"}],"properties":{"module":"scrL3Detalhe","type":"scrL3Detalhe.conEcraL3b.conConteudoL3b.conL3bCartao.conL3PubsUtil.lblL3TituloPubs","member":"Text"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CountRowsGalleryAllItems","ruleIndex":3,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scrL3Lista.conEcraL3a.conConteudoL3a.conL3Barra.lblL3Contagem.Text"}},"logicalLocations":[{"fullyQualifiedName":"scrL3Lista.conEcraL3a.conConteudoL3a.conL3Barra.lblL3Contagem.Text"}],"properties":{"module":"scrL3Lista","type":"scrL3Lista.conEcraL3a.conConteudoL3a.conL3Barra.lblL3Contagem","member":"Text"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-CountRowsGalleryAllItems","messageStrings":{"issue":{"text":"Utilizar AllItemsCount em vez de CountRows com AllItems"}},"properties":{"howToFix":["Substitua CountRows(Gallery.AllItems) por Gallery.AllItemsCount para obter um melhor desempenho."],"whyFix":"Utilizar o CountRows com a propriedade AllItems de uma galeria força a criação de uma tabela de saída que contém uma cópia da origem de dados de entrada e o estado atual de todos os controlos secundários. Isto pode forçar a inicialização de linhas não inicializadas, consumindo ciclos de CPU adicionais, memória e, potencialmente, desencadeando pedidos de rede ao nível da linha.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}