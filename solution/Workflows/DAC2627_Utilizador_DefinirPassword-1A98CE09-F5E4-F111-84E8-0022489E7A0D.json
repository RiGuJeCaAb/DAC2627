                    "less": [
                      "@length(coalesce(triggerBody()?['text_2'],''))",
                      8
                    ]
                  },
                  {
                    "greater": [
                      "@length(coalesce(triggerBody()?['text_2'],''))",
                      128
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "E_o_proprio": {
              "actions": {
                "Verificar_atual": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
