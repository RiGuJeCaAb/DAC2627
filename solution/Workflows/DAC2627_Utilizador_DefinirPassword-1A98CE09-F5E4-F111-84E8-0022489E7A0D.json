          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Token",
                  "type": "string",
                  "description": "Testemunho de sessão devolvido pelo fluxo Entrar",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_1": {
                  "title": "UtilizadorId",
                  "type": "string",
                  "description": "GUID do utilizador a alterar (vazio = o próprio)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_2": {
                  "title": "NovaPassword",
                  "type": "string",
                  "description": "Nova password, entre 8 e 128 caracteres",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "text_3": {
                  "title": "PasswordAtual",
                  "type": "string",
                  "description": "Password atual (obrigatória quando é o próprio)",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "text",
                "text_1",
                "text_2",
                "text_3"
              ]
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "outputs"
              ]
            }
          }
        }
      },
      "actions": {
        "Tentar": {
          "actions": {
            "Ler_sessao": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "dac_utilizadors",
                  "$top": 1,
                  "$select": "dac_utilizadorid,dac_nome,dac_email,dac_perfil,dac_passwordhash,dac_passwordsalt,dac_iteracoes,dac_sessaotoken",
                  "$filter": "dac_sessaotoken eq '@{replace(triggerBody()?['text'],'''','''''')}' and dac_sessaoexpira gt @{utcNow()} and dac_ativo eq true"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Sem_sessao": {
              "actions": {
                "Responder_sem_sessao": {
                  "runAfter": {},
                  "type": "Response",
                  "kind": "PowerApp",
                  "inputs": {
                    "statusCode": 200,
                    "body": {
                      "resultado": "erro",
                      "mensagem": "Sessão inválida ou expirada. Entrar de novo.",
                      "token": "",
                      "nome": "",
                      "perfil": "",
                      "utilizadorid": "",
                      "clienteid": ""
                    },
                    "schema": {
                      "type": "object",
                      "properties": {
                        "resultado": {
                          "title": "resultado",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "mensagem": {
                          "title": "mensagem",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "token": {
                          "title": "token",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "nome": {
                          "title": "nome",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "perfil": {
                          "title": "perfil",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "utilizadorid": {
                          "title": "utilizadorid",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "clienteid": {
                          "title": "clienteid",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        }
                      }
                    }
                  }
                },
                "Terminar_sem_sessao": {
                  "runAfter": {
                    "Responder_sem_sessao": [
                      "Succeeded"
                    ]
                  },
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  }
                }
              },
              "runAfter": {
                "Ler_sessao": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "equals": [
                  "@length(outputs('Ler_sessao')?['body/value'])",
                  0
                ]
              },
              "type": "If"
            },
            "Alvo": {
              "runAfter": {
                "Sem_sessao": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@if(empty(trim(coalesce(triggerBody()?['text_1'],''))),first(outputs('Ler_sessao')?['body/value'])?['dac_utilizadorid'],trim(triggerBody()?['text_1']))"
            },
            "Tamanho_invalido": {
              "actions": {
                "Responder_tamanho": {
                  "runAfter": {},
                  "type": "Response",
                  "kind": "PowerApp",
                  "inputs": {
                    "statusCode": 200,
                    "body": {
                      "resultado": "erro",
                      "mensagem": "A nova password tem de ter entre 8 e 128 caracteres.",
                      "token": "",
                      "nome": "",
                      "perfil": "",
                      "utilizadorid": "",
                      "clienteid": ""
                    },
                    "schema": {
                      "type": "object",
                      "properties": {
                        "resultado": {
                          "title": "resultado",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "mensagem": {
                          "title": "mensagem",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "token": {
                          "title": "token",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "nome": {
                          "title": "nome",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "perfil": {
                          "title": "perfil",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "utilizadorid": {
                          "title": "utilizadorid",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        },
                        "clienteid": {
                          "title": "clienteid",
                          "type": "string",
                          "x-ms-dynamically-added": true
                        }
