                      "body/salt": "@first(outputs('Ler_sessao')?['body/value'])?['dac_passwordsalt']",
                      "body/hash": "@first(outputs('Ler_sessao')?['body/value'])?['dac_passwordhash']",
                      "body/iteracoes": "@first(outputs('Ler_sessao')?['body/value'])?['dac_iteracoes']"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  }
                },
                "Atual_errada": {
                  "actions": {
                    "Responder_atual_errada": {
                      "runAfter": {},
                      "type": "Response",
                      "kind": "PowerApp",
                      "inputs": {
                        "statusCode": 200,
                        "body": {
                          "resultado": "erro",
                          "mensagem": "A password atual não está certa.",
                          "token": "",
                          "nome": "",
                          "perfil": "",
                          "utilizadorid": "",
                          "clienteid": ""
                        },
                        "schema": {
                          "type": "object",
                          "properties": {
                            "resultado": {
                              "title": "resultado",
                              "type": "string",
                              "x-ms-dynamically-added": true
                            },
                            "mensagem": {
                              "title": "mensagem",
                              "type": "string",
                              "x-ms-dynamically-added": true
                            },
                            "token": {
                              "title": "token",
                              "type": "string",
                              "x-ms-dynamically-added": true
                            },
                            "nome": {
                              "title": "nome",
                              "type": "string",
                              "x-ms-dynamically-added": true
                            },
                            "perfil": {
                              "title": "perfil",
                              "type": "string",
                              "x-ms-dynamically-added": true
                            },
                            "utilizadorid": {
                              "title": "utilizadorid",
                              "type": "string",
                              "x-ms-dynamically-added": true
                            },
                            "clienteid": {
                              "title": "clienteid",
                              "type": "string",
                              "x-ms-dynamically-added": true
                            }
                          }
                        }
                      }
                    },
                    "Terminar_atual_errada": {
                      "runAfter": {
                        "Responder_atual_errada": [
                          "Succeeded"
                        ]
                      },
                      "type": "Terminate",
                      "inputs": {
                        "runStatus": "Succeeded"
                      }
                    }
                  },
                  "runAfter": {
                    "Verificar_atual": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "not": {
                      "equals": [
                        "@body('Verificar_atual')?['valido']",
                        true
                      ]
                    }
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Tamanho_invalido": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Nao_e_admin": {
                    "actions": {
                      "Responder_nao_admin": {
                        "runAfter": {},
                        "type": "Response",
                        "kind": "PowerApp",
                        "inputs": {
                          "statusCode": 200,
                          "body": {
                            "resultado": "erro",
                            "mensagem": "Só um Admin define a password de outro utilizador.",
                            "token": "",
                            "nome": "",
                            "perfil": "",
                            "utilizadorid": "",
                            "clienteid": ""
                          },
                          "schema": {
                            "type": "object",
                            "properties": {
                              "resultado": {
                                "title": "resultado",
                                "type": "string",
                                "x-ms-dynamically-added": true
                              },
                              "mensagem": {
                                "title": "mensagem",
                                "type": "string",
                                "x-ms-dynamically-added": true
                              },
                              "token": {
                                "title": "token",
                                "type": "string",
                                "x-ms-dynamically-added": true
                              },
                              "nome": {
                                "title": "nome",
                                "type": "string",
                                "x-ms-dynamically-added": true
                              },
                              "perfil": {
                                "title": "perfil",
                                "type": "string",
                                "x-ms-dynamically-added": true
                              },
                              "utilizadorid": {
                                "title": "utilizadorid",
                                "type": "string",
                                "x-ms-dynamically-added": true
                              },
                              "clienteid": {
                                "title": "clienteid",
                                "type": "string",
                                "x-ms-dynamically-added": true
                              }
                            }
                          }
                        }
                      },
                      "Terminar_nao_admin": {
                        "runAfter": {
                          "Responder_nao_admin": [
                            "Succeeded"
                          ]
                        },
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Succeeded"
                        }
                      }
                    },
                    "runAfter": {},
                    "else": {
                      "actions": {}
                    },
                    "expression": {
                      "not": {
                        "equals": [
                          "@first(outputs('Ler_sessao')?['body/value'])?['dac_perfil']",
                          774300000
                        ]
                      }
                    },
                    "type": "If"
                  }
                }
              },
              "expression": {
                "equals": [
                  "@equals(toLower(outputs('Alvo')),toLower(first(outputs('Ler_sessao')?['body/value'])?['dac_utilizadorid']))",
                  true
                ]
              },
              "type": "If"
            },
            "Gerar_hash": {
              "runAfter": {
                "E_o_proprio": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_dac-5Fdac2627-2Dservicohash-5F8e4ce826bfe060bc",
                  "operationId": "GerarHash",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_dac-5Fdac2627-2Dservicohash-5F8e4ce826bfe060bc"
                },
                "parameters": {
                  "body/password": "@triggerBody()?['text_2']"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            },
            "Gravar_hash": {
              "runAfter": {
                "Gerar_hash": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "dac_utilizadors",
                  "recordId": "@outputs('Alvo')",
                  "item/dac_passwordhash": "@body('Gerar_hash')?['hash']",
                  "item/dac_passwordsalt": "@body('Gerar_hash')?['salt']",
                  "item/dac_iteracoes": "@body('Gerar_hash')?['iteracoes']",
                  "item/dac_algoritmo": "@body('Gerar_hash')?['algoritmo']",
                  "item/dac_tentativasfalhadas": 0,
                  "item/dac_bloqueadoate": null,
                  "item/dac_sessaotoken": "@if(equals(toLower(outputs('Alvo')),toLower(first(outputs('Ler_sessao')?['body/value'])?['dac_utilizadorid'])),first(outputs('Ler_sessao')?['body/value'])?['dac_sessaotoken'],null)"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            },
            "Responder_ok": {
              "runAfter": {
                "Gravar_hash": [
                  "Succeeded"
                ]
              },
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "resultado": "ok",
                  "mensagem": "Password definida.",
                  "token": "",
                  "nome": "",
                  "perfil": "",
                  "utilizadorid": "",
                  "clienteid": ""
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "resultado": {
                      "title": "resultado",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "mensagem": {
                      "title": "mensagem",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "token": {
                      "title": "token",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "nome": {
                      "title": "nome",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "perfil": {
                      "title": "perfil",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "utilizadorid": {
                      "title": "utilizadorid",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "clienteid": {
                      "title": "clienteid",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    }
                  }
                }
              }
            }
          },
          "runAfter": {},
          "type": "Scope"
        },
        "Tratar_erro": {
          "actions": {
            "Responder_erro": {
              "runAfter": {},
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "resultado": "erro",
                  "mensagem": "Não foi possível definir a password. Confirmar o utilizador e tentar de novo.",
                  "token": "",
                  "nome": "",
                  "perfil": "",
                  "utilizadorid": "",
                  "clienteid": ""
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "resultado": {
                      "title": "resultado",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "mensagem": {
                      "title": "mensagem",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "token": {
                      "title": "token",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "nome": {
                      "title": "nome",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "perfil": {
                      "title": "perfil",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "utilizadorid": {
                      "title": "utilizadorid",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    },
                    "clienteid": {
                      "title": "clienteid",
                      "type": "string",
                      "x-ms-dynamically-added": true
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "Tentar": [
              "Failed",
              "TimedOut"
            ]
          },
          "type": "Scope"
        }
      }
